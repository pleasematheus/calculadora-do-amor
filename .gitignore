# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.tokensave

# astryx theme build: só o .css é importado (app/layout.tsx); o módulo JS e as
# declarações que saem junto não são usados por ninguém.
app/amor.js
app/amor.d.ts
app/amor.variants.d.ts

# ferramentas
.claude/
.impeccable/